# Arcaevo web — environment variables (copy to .env.local for dev)

# MongoDB connection string. Local dev: docker compose up -d mongo.
# Prod: MongoDB Atlas (eu-west-1) — string lives in AWS Secrets Manager
# (see infra/cdk).
MONGODB_URI=mongodb://localhost:27017/arcaevo

# Admin auth (docs/MOCKED_APIS.md §3). Per-admin accounts live in the `admins`
# collection; ADMIN_PASSWORD is the BOOTSTRAP OWNER credential (password-only
# break-glass login). REQUIRED in production UNLESS ADMIN_BOOTSTRAP_DISABLED=true.
ADMIN_PASSWORD=change-me-local
# Email the bootstrap OWNER account is keyed to (seed + password-only login).
# FIRST-BOOT AUTO-SEED: when the `admins` collection is EMPTY and BOTH
# ADMIN_EMAIL and ADMIN_PASSWORD are set, boot auto-creates ONE real owner
# admin (role "owner", scrypt-hashed ADMIN_PASSWORD) — so /admin has a real
# login without ever running the data-wiping seed script in prod. Idempotent:
# once any admin exists it never runs again and NEVER edits an existing account.
# Intended production value is accounts@arcaevo.com. ADMIN_PASSWORD is that
# owner's INITIAL password — change/rotate it after first login + MFA enrolment
# (the auto-seeded owner is put through mandatory MFA like any real account).
# Defaults to owner@arcaevo.local (auto-seed OFF) when unset.
# ADMIN_EMAIL=accounts@arcaevo.com

# Disable the shared-password BOOTSTRAP OWNER login entirely (security audit A-1).
# OFF by default so dev, first-login and the e2e password flow keep working. Once
# a REAL owner account exists and has MFA enrolled, set this to "true" in prod:
# the password-only path is then rejected wholesale (no shared, MFA-exempt,
# non-revocable owner credential), and ADMIN_PASSWORD is no longer required to
# boot. Real per-admin accounts (email + password + MANDATORY MFA) are unaffected.
# ADMIN_BOOTSTRAP_DISABLED=true

# Secret path segment the admin DASHBOARD is served under (defense-in-depth on
# top of the auth guards — docs/MOCKED_APIS.md §3). Defaults to "admin" so dev +
# e2e reach /admin with zero config. PRODUCTION MUST set this to a LONG, RANDOM,
# non-guessable value: /{ADMIN_PATH_SLUG}/* is rewritten to the dashboard, while
# direct /admin/* requests return 404 so scanners probing /admin, /wp-admin, …
# find nothing. NEVER a NEXT_PUBLIC_ var (that would leak it to the public site);
# the API under /api/v1/admin/* is NOT obscured (it is guarded by the session).
# ADMIN_PATH_SLUG=change-me-long-random-slug

# Secret for HMAC-signing the admin session cookie. REQUIRED in production —
# the app fails closed (throws, refuses to boot) if unset when
# NODE_ENV=production. A dev fallback is used ONLY in non-production. Set this
# to a long random string in every real environment.
SESSION_SECRET=change-me-long-random-string

# Encryption key for admin TOTP MFA secrets at rest (docs/MOCKED_APIS.md §3).
# The per-admin TOTP secret is sealed with AES-256-GCM under a key derived from
# this value, so a DB compromise alone yields no working 2FA secret. FAIL-CLOSED
# in production: if any admin has MFA enabled and this is unset, the enable/
# verify paths throw rather than seal under a fallback key. In non-production it
# derives from SESSION_SECRET (dev is not a security boundary). MFA is now
# MANDATORY for every real per-admin account (a password-only login with no MFA
# is forced through enrolment before any session is issued), so set a long random
# string in EVERY real environment. Rotating it invalidates existing TOTP secrets
# (admins re-enrol; backup codes still work). The break-glass bootstrap owner is
# the only MFA-exempt path — turn it off in prod with ADMIN_BOOTSTRAP_DISABLED.
# MFA_ENC_KEY=change-me-long-random-string

# --- Blood-tier feature flag ------------------------------------------------
# Gates the PAID blood-testing tiers: Essential (€329) + Performance (€399), the
# lab-kit / nurse / venous order types + add-ons, gifting, and clinician review.
# The Fusion tier (€119 — Apple Watch + user-uploaded bloods) is ALWAYS on and
# never gated by this. FAIL-SAFE OFF: enabled ONLY when the value is exactly
# "true"; unset / anything else = DISABLED. Dev + pre-prod set BOTH to "true";
# PRODUCTION leaves BOTH UNSET (blood tiers off) until the lab/phlebotomy partner
# and a real clinician are live — so we never sell what we can't yet fulfil.
#  - BLOOD_TIERS_ENABLED is the SERVER source of truth (enforced in the
#    checkout/orders/gift routes; exposed publicly via GET /api/v1/config so the
#    iOS app can read it at runtime without a rebuild).
#  - NEXT_PUBLIC_BLOOD_TIERS_ENABLED is the client-visible mirror for UI. It is
#    inlined at BUILD time, so set it before `next build` in pre-prod.
# BLOOD_TIERS_ENABLED=true
# NEXT_PUBLIC_BLOOD_TIERS_ENABLED=true

# --- Mock-vendor / demo gates (leave UNSET in real production) --------------
# Honour the static demo bearer token ("demo-member-token", which maps to a
# real seeded member's health data). Auto-on in non-production; in production
# it is OFF unless set to "true". Local prod-build stacks (docker/e2e) set it.
# ALLOW_DEMO_TOKEN=true

# LetsGetChecked MOCK webhook shared secret (sent as `x-arcaevo-webhook-secret`).
# When set, the header must match in ALL environments. Leave unset in dev.
# LETSGETCHECKED_WEBHOOK_SECRET=

# --- Stripe (real integration; docs/MOCKED_APIS.md §2 + docs/STRIPE_SETUP.md) --
# TEST keys for dev; swap for live (ideally a restricted rk_live_) in prod. NEVER
# commit real keys — put them in .env.local (gitignored), not here.
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret. When SET, /api/v1/webhooks/stripe uses REAL
# Stripe-Signature verification; while UNSET it keeps the dev/e2e mock path
# (shared-secret). Get it from `stripe listen` (dev) or a Dashboard endpoint (prod).
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Force the deterministic MOCK vendor even when a key is present (fast off-switch).
# The LIVE vendor is selected automatically whenever STRIPE_SECRET_KEY is a real key.
# STRIPE_FORCE_MOCK=true
# Optional: pin resolved Price ids (else the live vendor resolves by lookup_key at
# runtime). Create them with `npm run stripe:setup`.
# STRIPE_PRICE_ARCAEVO_FUSION_ANNUAL=price_xxx
# STRIPE_PRICE_ARCAEVO_ESSENTIAL_ANNUAL=price_xxx
# STRIPE_PRICE_ARCAEVO_PERFORMANCE_ANNUAL=price_xxx
# STRIPE_PRICE_ARCAEVO_QUARTERLY_UPGRADE=price_xxx
# STRIPE_PRICE_ARCAEVO_ADDON_FULL_PANEL=price_xxx
# STRIPE_PRICE_ARCAEVO_ADDON_RECHECK=price_xxx
# STRIPE_PRICE_ARCAEVO_ADDON_VENOUS=price_xxx
# STRIPE_PRICE_ARCAEVO_RECHECK_KIT=price_xxx

# Escape hatch: keep the mock webhooks OPEN on a prod-build LOCAL stack when no
# webhook secret is configured (docker/e2e). NEVER set this in real production.
# ALLOW_OPEN_WEBHOOKS=true

# Keep the MOCK AI bloodwork extraction ON (it fabricates marker values from the
# file name — docs/MOCKED_APIS.md §11). Auto-on in non-production; in production
# it is OFF unless set to "true", so the photo/PDF upload path returns an honest
# "enter your values by hand" state instead of inventing numbers a real user
# would confirm. Local prod-build stacks (docker/e2e) set it. NEVER in real prod
# until a real EU OCR vendor lands.
# ALLOW_MOCK_EXTRACTION=true

# Opt OUT of IP rate-limiting on the auth endpoints (magic-link request/verify,
# signin). Limiting is ON by default in every environment; a local prod-build
# stack (docker/e2e) sets this so scripted sign-in bursts from one host don't
# trip the limiter. NEVER set this in real production.
# RATE_LIMIT_DISABLED=true

# Bearer secret for the scheduled GDPR erasure cron (docs/MOCKED_APIS.md §17).
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to
# /api/v1/cron/run-erasure. When set, a matching bearer is required in every
# environment; in production WITHOUT it the cron route fails closed (401). Set a
# long random string in real production; the CLI runner (`npm run erase:run`)
# stays as the manual/AWS fallback.
# CRON_SECRET=change-me-long-random-string

# Canonical site URL (metadata, sitemap, OG cards).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog EU project key. Leave blank to disable analytics entirely
# (EU host https://eu.i.posthog.com is hardcoded — never US-hosted).
NEXT_PUBLIC_POSTHOG_KEY=

# --- Email (docs/MOCKED_APIS.md §7) -----------------------------------------
# Provider: unset = outbox-only (Mongo). "mailhog"/"smtp" ALSO sends via SMTP.
# EMAIL_PROVIDER=mailhog
# SMTP host/port (defaults localhost:1026 for MailHog). Point at an EU ESP
# (Scaleway TEM / Postmark EU — sign a DPA) for prod: a config change, not code.
# SMTP_HOST=localhost
# SMTP_PORT=1026
# Optional auth — set BOTH to enable (unset = no auth, for MailHog).
# SMTP_USER=
# SMTP_PASS=
# TLS-on-connect (465-style). The literal string "true" enables it; default false.
# SMTP_SECURE=true
# Override the From address (default "Arcaevo <hello@arcaevo.com>").
# EMAIL_FROM=Arcaevo <hello@arcaevo.com>

# --- AWS credentials (generic; SES email + Bedrock narration + future infra) --
# Bare AWS_* names are RESERVED on Vercel's Lambda runtime, so use ARCAEVO_AWS_*.
# ARCAEVO_AWS_REGION=eu-west-1
# ARCAEVO_AWS_ACCESS_KEY_ID=AKIA...
# ARCAEVO_AWS_SECRET_ACCESS_KEY=...
# OPTIONAL: only for STS temporary credentials (e.g. assumed-role smoke tests);
# signed + sent as x-amz-security-token. Long-lived IAM keys (the normal
# production path) do NOT need it — leave unset.
# ARCAEVO_AWS_SESSION_TOKEN=

# --- AI narration (Amazon Bedrock, Claude Haiku) — docs/MOCKED_APIS.md §20 ----
# "Deterministic rules decide, AI narrates": when ON, GET /api/v1/insights
# attaches an ADDITIVE `narration` (a warmer Claude rewrite of the template
# `text`) to eligible insights — never flagged/watch values, which stay
# clinician-only. Cache-first + fire-and-forget: the GET never waits on the
# model; any failure ships the unchanged template. DEFAULT-ON: the
# ARCAEVO_AWS_* key pair above IS the switch (founder decision 2026-07-06 —
# no separate flag). No keys (dev/e2e/CI default) = templates only; keys set
# locally = live narration, so you can verify it in dev. The CDK email stack
# (infra/cdk/lib/arcaevo-email-stack.ts) grants bedrock:InvokeModel to those
# same keys — redeploy ArcaevoEmailStack to apply, or background calls 403
# harmlessly (template ships, one log line per attempt). Region comes from
# ARCAEVO_AWS_REGION (default eu-west-1 — EU data residency; the LLM provider
# is already listed as a sub-processor on /legal/privacy).
# Bedrock model id. Default is the EU cross-region INFERENCE PROFILE for
# Claude Haiku 4.5 (eu.anthropic.claude-haiku-4-5-20251001-v1:0), and the
# profile form is REQUIRED: live-verified 2026-07-06 — the profile works in
# eu-west-1, while the bare "anthropic.claude-haiku-4-5-20251001-v1:0"
# foundation-model id is REJECTED for on-demand InvokeModel ("Retry with an
# inference profile"). Override only for a different model/profile.
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
